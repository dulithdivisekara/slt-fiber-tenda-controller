# ==============================================================================
# SLT Fiber Tenda HG7 Router Controller — Environment Configuration Template
# Copy this file to .env and configure your router credentials.
# ==============================================================================

# Router Gateway IP or Hostname (default: 192.168.1.1)
TENDA_HOST=192.168.1.1

# Standard User Credentials (default: admin / admin)
TENDA_USERNAME=admin
TENDA_PASSWORD=admin

# ISP Super Administrator Credentials (for Multi-WAN, VoIP, ACL, TR-069 inspection)
TENDA_SUPER_USERNAME=administrator
TENDA_SUPER_PASSWORD=your_super_admin_password_here

# Network Request Timeout in seconds (default: 10.0)
TENDA_TIMEOUT=10.0
